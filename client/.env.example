# Copy to .env.local for local development. All values are server-only (not NEXT_PUBLIC_),
# so none of them are sent to the browser. In Azure, set them as App Service application settings.

# ---------- Backend ----------

# Base URL of the NotificationService Azure Functions app (no trailing /api).
# Local `func start` listens on 7071; the Visual Studio profile uses 7262.
FUNCTIONS_BASE_URL=http://localhost:7071

# Function key (the Function App's default host key). Not needed locally; required in Azure.
FUNCTIONS_KEY=

# ---------- Sign-in (Microsoft Entra ID app registration, MSAL) ----------

AZURE_AD_TENANT_ID=fa9a6c58-514f-4252-b674-5b4c7fb025a2
AZURE_AD_CLIENT_ID=5626cd9b-4bce-485e-97ff-80e4fff07ec0

# Secret. Never commit it; use Key Vault references in Azure.
AZURE_AD_CLIENT_SECRET=

# Public URL of this app. Register these in the app registration (platform: Web):
#   Redirect URI:     {APP_BASE_URL}/api/auth/callback
#   Front-channel / post-logout URI: {APP_BASE_URL}/login
APP_BASE_URL=https://localhost:3000

# Encrypts the session cookie. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=
